{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/story-event.schema.json",
  "title": "StoryEvent",
  "type": "object",
  "required": ["schema_version", "event_id", "book_id", "chapter_id", "scene_id", "event_index", "event_type", "cause", "action", "result", "consequence", "participants", "evidence_refs"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "book_id": { "type": "string", "minLength": 1 },
    "chapter_id": { "type": "string", "minLength": 1 },
    "scene_id": { "type": ["string", "null"], "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "payload": { "type": "object", "additionalProperties": true },
    "event_id": { "type": "string", "minLength": 1 },
    "event_index": { "type": "integer", "minimum": 1 },
    "event_type": { "type": "string", "minLength": 1 },
    "cause": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "result": { "type": "string", "minLength": 1 },
    "consequence": { "type": "string", "minLength": 1 },
    "participants": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
