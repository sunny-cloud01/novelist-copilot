{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/feedback-record.schema.json",
  "title": "FeedbackRecord",
  "type": "object",
  "required": [
    "schema_version",
    "feedback_record_id",
    "workspace_id",
    "request_id",
    "trace_id",
    "actor_id",
    "target_type",
    "target_id",
    "feedback_type",
    "score",
    "source",
    "comment_ref",
    "payload",
    "promotion_status",
    "input_refs",
    "output_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "feedback_record_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "target_type": {
      "type": "string",
      "enum": ["writing_run", "quality_report", "section_run", "chapter"]
    },
    "target_id": { "type": "string", "minLength": 1 },
    "feedback_type": {
      "type": "string",
      "enum": ["acceptance", "quality", "style", "cost", "edit_distance"]
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "string",
      "enum": ["human_review", "critic", "quality_gate", "system"]
    },
    "comment_ref": { "type": ["string", "null"], "minLength": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "promotion_status": {
      "type": "string",
      "enum": ["pending", "promoted", "rolled_back"]
    },
    "input_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "output_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
