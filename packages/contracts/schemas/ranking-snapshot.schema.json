{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/ranking-snapshot.schema.json",
  "title": "RankingSnapshot",
  "type": "object",
  "required": [
    "schema_version",
    "ranking_snapshot_id",
    "workspace_id",
    "trace_id",
    "ranking_type",
    "scope_ref",
    "version",
    "updated_at",
    "items",
    "signals",
    "suggestions"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "ranking_snapshot_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "ranking_type": {
      "type": "string",
      "enum": ["prompt", "pattern", "knowledge", "rhythm", "asset"]
    },
    "scope_ref": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "target_type", "target_id", "label", "score", "status", "signal_ids"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "target_type": {
            "type": "string",
            "enum": ["prompt_version", "pattern", "knowledge_object", "rhythm_profile", "asset"]
          },
          "target_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": {
            "type": "string",
            "enum": ["leading", "watch", "deprecated"]
          },
          "signal_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "summary": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "signals": {
      "type": "array",
      "items": { "$ref": "https://novelfactory.dev/schemas/ranking-signal.schema.json" }
    },
    "suggestions": {
      "type": "array",
      "items": { "$ref": "https://novelfactory.dev/schemas/ranking-suggestion.schema.json" }
    }
  },
  "additionalProperties": false
}
