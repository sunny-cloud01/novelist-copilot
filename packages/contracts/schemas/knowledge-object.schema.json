{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/knowledge-object.schema.json",
  "title": "KnowledgeObject",
  "type": "object",
  "required": [
    "schema_version",
    "object_id",
    "workspace_id",
    "object_type",
    "canonical_name",
    "lifecycle_status",
    "review_status",
    "confidence",
    "evidence_refs",
    "payload"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "object_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "object_type": { "type": "string", "minLength": 1 },
    "canonical_name": { "type": "string", "minLength": 1 },
    "lifecycle_status": { "type": "string", "enum": ["candidate", "approved", "rejected"] },
    "review_status": { "type": "string", "enum": ["pending", "approved", "rejected", "merged", "reextract_requested"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "payload": {
      "type": "object",
      "required": ["schema_version"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
