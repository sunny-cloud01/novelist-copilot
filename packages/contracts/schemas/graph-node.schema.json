{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/graph-node.schema.json",
  "title": "GraphNode",
  "type": "object",
  "required": [
    "schema_version",
    "node_id",
    "book_id",
    "label",
    "node_type",
    "canonical_object_id",
    "review_status",
    "lifecycle_status",
    "confidence",
    "aliases",
    "summary",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "book_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "node_type": { "type": "string", "minLength": 1 },
    "canonical_object_id": { "type": "string", "minLength": 1 },
    "review_status": { "type": "string", "minLength": 1 },
    "lifecycle_status": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
