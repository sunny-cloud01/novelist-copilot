{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/model-profile.schema.json",
  "title": "ModelProfile",
  "type": "object",
  "required": [
    "schema_version",
    "model_profile_id",
    "provider_name",
    "provider_model_name",
    "label",
    "enabled",
    "supports_structured_output",
    "fallback_profile_ids"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "model_profile_id": { "type": "string", "minLength": 1 },
    "provider_name": { "type": "string", "minLength": 1 },
    "provider_model_name": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "enabled": { "type": "boolean" },
    "supports_structured_output": { "type": "boolean" },
    "fallback_profile_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
