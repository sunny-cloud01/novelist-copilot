{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/relationship-edge.schema.json",
  "title": "RelationshipEdge",
  "type": "object",
  "required": ["schema_version", "edge_id", "book_id", "source_id", "relation_type", "target_id", "confidence", "evidence_id", "evidence_refs"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "book_id": { "type": "string", "minLength": 1 },
    "chapter_id": { "type": "string", "minLength": 1 },
    "scene_id": { "type": ["string", "null"], "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "payload": { "type": "object", "additionalProperties": true },
    "edge_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "relation_type": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "evidence_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
