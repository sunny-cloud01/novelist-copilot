{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/novel-project.schema.json",
  "title": "NovelProject",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "workspace_id",
    "title",
    "genre_scope",
    "status",
    "story_bible_id",
    "quality_gate_profile_id",
    "allowed_knowledge_source_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "genre_scope": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "planning", "writing", "review", "accepted"] },
    "story_bible_id": { "type": "string", "minLength": 1 },
    "quality_gate_profile_id": { "type": "string", "minLength": 1 },
    "allowed_knowledge_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
