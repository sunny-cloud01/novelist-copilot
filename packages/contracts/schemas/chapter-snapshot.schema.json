{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/chapter-snapshot.schema.json",
  "title": "ChapterSnapshot",
  "type": "object",
  "required": [
    "schema_version",
    "chapter_snapshot_id",
    "writing_run_id",
    "project_id",
    "chapter_plan_id",
    "accepted_chapter_ref",
    "chapter_title",
    "chapter_text",
    "source_section_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "chapter_snapshot_id": { "type": "string", "minLength": 1 },
    "writing_run_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "chapter_plan_id": { "type": "string", "minLength": 1 },
    "accepted_chapter_ref": { "type": "string", "minLength": 1 },
    "chapter_title": { "type": "string", "minLength": 1 },
    "chapter_text": { "type": "string", "minLength": 1 },
    "source_section_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
