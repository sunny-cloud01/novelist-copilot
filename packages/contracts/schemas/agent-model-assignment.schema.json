{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/agent-model-assignment.schema.json",
  "title": "AgentModelAssignment",
  "type": "object",
  "required": [
    "schema_version",
    "assignment_id",
    "agent_role",
    "task_type",
    "output_mode",
    "model_profile_id",
    "fallback_profile_ids",
    "max_retry",
    "max_cost",
    "enabled"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "assignment_id": { "type": "string", "minLength": 1 },
    "agent_role": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "output_mode": { "type": "string", "minLength": 1 },
    "model_profile_id": { "type": "string", "minLength": 1 },
    "fallback_profile_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "max_retry": { "type": "integer", "minimum": 0 },
    "max_cost": { "type": "number", "minimum": 0 },
    "enabled": { "type": "boolean" }
  },
  "additionalProperties": false
}
