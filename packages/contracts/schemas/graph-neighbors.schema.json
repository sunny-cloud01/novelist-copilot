{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/graph-neighbors.schema.json",
  "title": "GraphNeighbors",
  "type": "object",
  "required": ["node_id", "items"],
  "properties": {
    "node_id": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edge_id",
          "relation_type",
          "direction",
          "neighbor_node_id",
          "neighbor_label",
          "neighbor_type",
          "confidence",
          "evidence_refs"
        ],
        "properties": {
          "edge_id": { "type": "string", "minLength": 1 },
          "relation_type": { "type": "string", "minLength": 1 },
          "direction": { "type": "string", "enum": ["incoming", "outgoing"] },
          "neighbor_node_id": { "type": "string", "minLength": 1 },
          "neighbor_label": { "type": "string", "minLength": 1 },
          "neighbor_type": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
