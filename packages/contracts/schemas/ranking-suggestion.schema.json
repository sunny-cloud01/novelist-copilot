{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/ranking-suggestion.schema.json",
  "title": "RankingSuggestion",
  "type": "object",
  "required": [
    "schema_version",
    "suggestion_id",
    "workspace_id",
    "trace_id",
    "ranking_type",
    "target_scope",
    "status",
    "summary",
    "recommended_action",
    "source_signal_ids",
    "input_refs",
    "output_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "suggestion_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "ranking_type": {
      "type": "string",
      "enum": ["prompt", "pattern", "knowledge", "rhythm", "asset"]
    },
    "target_scope": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["review_required", "approved", "rejected", "superseded"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "recommended_action": { "type": "string", "minLength": 1 },
    "source_signal_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "promoted_from_feedback_record_id": { "type": ["string", "null"], "minLength": 1 },
    "input_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "output_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "promoted_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
