{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/knowledge-source-summary.schema.json",
  "title": "KnowledgeSourceSummary",
  "type": "object",
  "required": [
    "source_ref",
    "label",
    "book_id",
    "source_type",
    "status",
    "knowledge_object_count",
    "evidence_count",
    "updated_at"
  ],
  "properties": {
    "source_ref": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "book_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": ["string", "null"], "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ready", "committed", "analyzing", "failed"] },
    "knowledge_object_count": { "type": "integer", "minimum": 0 },
    "evidence_count": { "type": "integer", "minimum": 0 },
    "graph_summary_ref": { "type": ["string", "null"], "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
