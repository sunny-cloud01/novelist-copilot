{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/chapter-plan.schema.json",
  "title": "ChapterPlan",
  "type": "object",
  "required": [
    "schema_version",
    "chapter_plan_id",
    "workspace_id",
    "project_id",
    "trace_id",
    "input_refs",
    "output_refs",
    "chapter_index",
    "status",
    "target_word_count",
    "payload",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "chapter_plan_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "input_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "output_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "chapter_index": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["queued", "running", "retrying", "succeeded", "failed", "requires_review", "blocked", "approved"] },
    "target_word_count": { "type": "integer", "minimum": 1 },
    "payload": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
