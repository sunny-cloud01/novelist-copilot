{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/source-scene.schema.json",
  "title": "SourceScene",
  "type": "object",
  "required": ["schema_version", "scene_id", "book_id", "chapter_id", "scene_index", "title", "text_range", "segmentation_status", "segmentation_confidence", "evidence_refs"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "scene_id": { "type": "string", "minLength": 1 },
    "book_id": { "type": "string", "minLength": 1 },
    "chapter_id": { "type": "string", "minLength": 1 },
    "scene_index": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "text_range": { "type": "string", "minLength": 1 },
    "segmentation_status": { "type": "string", "enum": ["segmented", "review_required", "failed"] },
    "segmentation_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": ["string", "null"] },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "payload": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
