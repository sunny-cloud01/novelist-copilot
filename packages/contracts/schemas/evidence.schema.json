{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_ref",
    "book_id",
    "chapter_id",
    "chapter_index",
    "text_range",
    "excerpt",
    "source_object_refs",
    "confidence",
    "trace_id"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "evidence_ref": { "type": "string", "minLength": 1 },
    "book_id": { "type": "string", "minLength": 1 },
    "chapter_id": { "type": "string", "minLength": 1 },
    "chapter_index": { "type": "integer", "minimum": 1 },
    "text_range": { "type": "string", "minLength": 1 },
    "excerpt": { "type": "string", "minLength": 1 },
    "source_object_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_content_ref": { "type": ["string", "null"], "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "trace_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
