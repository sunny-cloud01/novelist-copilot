{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/pattern.schema.json",
  "title": "Pattern",
  "type": "object",
  "required": [
    "schema_version",
    "pattern_id",
    "workspace_id",
    "trace_id",
    "canonical_name",
    "pattern_type",
    "status",
    "intent",
    "preconditions",
    "steps",
    "slots",
    "expected_reader_effect",
    "compatible_rhythm_profile_id",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "pattern_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "canonical_name": { "type": "string", "minLength": 1 },
    "pattern_type": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "approved", "archived"] },
    "intent": { "type": "string", "minLength": 1 },
    "preconditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "summary"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "slots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "expected_reader_effect": { "type": "string", "minLength": 1 },
    "compatible_rhythm_profile_id": { "type": ["string", "null"], "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
