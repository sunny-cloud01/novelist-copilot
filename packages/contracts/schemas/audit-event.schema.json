{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/audit-event.schema.json",
  "title": "AuditEvent",
  "type": "object",
  "required": [
    "schema_version",
    "audit_event_id",
    "workspace_id",
    "request_id",
    "trace_id",
    "actor_id",
    "actor_role",
    "action",
    "target_type",
    "target_id",
    "target_ref",
    "before_ref",
    "after_ref",
    "reason",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "audit_event_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "actor_role": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "target_type": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "target_ref": { "type": "string", "minLength": 1 },
    "before_ref": { "type": ["string", "null"] },
    "after_ref": { "type": ["string", "null"] },
    "reason": { "type": "string", "minLength": 1 },
    "payload": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
