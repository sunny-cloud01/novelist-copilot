{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/ranking-signal.schema.json",
  "title": "RankingSignal",
  "type": "object",
  "required": [
    "schema_version",
    "signal_id",
    "workspace_id",
    "trace_id",
    "ranking_type",
    "target_type",
    "target_id",
    "signal_type",
    "score",
    "weight",
    "source",
    "summary",
    "evidence_refs",
    "input_refs",
    "output_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "signal_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "ranking_type": {
      "type": "string",
      "enum": ["prompt", "pattern", "knowledge", "rhythm", "asset"]
    },
    "target_type": {
      "type": "string",
      "enum": ["prompt_version", "pattern", "knowledge_object", "rhythm_profile", "asset"]
    },
    "target_id": { "type": "string", "minLength": 1 },
    "signal_type": {
      "type": "string",
      "enum": [
        "prompt_effectiveness",
        "pattern_fit",
        "rhythm_fit",
        "character_consistency",
        "world_consistency",
        "reader_interest",
        "repetition",
        "human_edit_distance"
      ]
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "source": {
      "type": "string",
      "enum": ["quality_gate", "critic", "human_review", "system"]
    },
    "source_feedback_record_id": { "type": ["string", "null"], "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "input_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "output_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
