{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelfactory.dev/schemas/rule-profile.schema.json",
  "title": "RuleProfile",
  "type": "object",
  "required": [
    "schema_version",
    "rule_id",
    "workspace_id",
    "trace_id",
    "rule_type",
    "title",
    "severity",
    "status",
    "scope_type",
    "scope_ref",
    "description",
    "condition_summary",
    "auto_block",
    "source_refs",
    "evidence_refs",
    "input_refs",
    "output_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "rule_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "rule_type": {
      "type": "string",
      "enum": [
        "character_continuity",
        "timeline_continuity",
        "location_continuity",
        "power_system_constraint",
        "artifact_uniqueness",
        "foreshadowing_constraint",
        "world_rule"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "status": { "type": "string", "enum": ["draft", "approved", "archived"] },
    "scope_type": {
      "type": "string",
      "enum": ["workspace", "project", "chapter_plan", "writing_run", "knowledge_object"]
    },
    "scope_ref": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "condition_summary": { "type": "string", "minLength": 1 },
    "auto_block": { "type": "boolean" },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "input_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "output_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
